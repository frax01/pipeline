class UniversalDynamicAnalyzer:
    """REAL Dynamic MCP Fuzzer - Actually starts servers and tests them live"""
    
    def __init__(self):
        self.running_servers = []
        self.active_processes = []
        self.vulnerability_scorer = VulnerabilityScorer() if VulnerabilityScorer else None
    

    async def _test_server_responsiveness(self, process: subprocess.Popen) -> bool:
        """Test if the server is responsive to basic input"""
        try:
            if process.poll() is not None:
                return False
            
            # Send a simple test message
            test_msg = {"jsonrpc": "2.0", "id": 1, "method": "ping"}
            try:
                process.stdin.write(json.dumps(test_msg) + '\n')
                process.stdin.flush()
            except (OSError, ValueError, BrokenPipeError):
                return False
            
            # Try to read any response (even error is good)
            try:
                response = await asyncio.wait_for(
                    asyncio.create_task(self._read_line_async(process)),
                    timeout=3.0
                )
                return response is not None
            except asyncio.TimeoutError:
                return process.poll() is None  # Still running is good enough
                
        except Exception:
            return False

    async def _read_line_async(self, process: subprocess.Popen) -> str:
        """Async wrapper for reading from process stdout"""
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, process.stdout.readline)

    def analyze_server(self, server_info: MCPServerInfo) -> List[Vulnerability]:
        """Perform dynamic analysis by actually running the MCP server"""
        vulnerabilities = []

        try:
            logger.info(f"Dynamic analysis of {server_info.name}")

            # HTTP servers need HTTP-based fuzzing instead of stdio
            if server_info.transport_type == 'http':
                logger.info("🌐 Detected HTTP server, running HTTP-based robustness fuzzing")
                http_vulns = asyncio.run(self._run_http_robustness_fuzzing(server_info))
                vulnerabilities.extend(http_vulns)
                return vulnerabilities

            # Start server using async method (same as real_fuzzing)
            server_process = asyncio.run(
                self._start_mcp_server_async(server_info.local_path, server_info.runtime_command)
            )

            if server_process:
                self._server_started = True
                logger.info("✅ MCP server started successfully")

                # Perform real fuzzing tests
                vulnerabilities.extend(self._perform_jsonrpc_fuzzing(server_info, server_process))
                vulnerabilities.extend(self._test_mcp_protocol_vulnerabilities(server_info, server_process))
                vulnerabilities.extend(self._test_resource_exhaustion(server_info))

                logger.info(f"lunghezza vulnerabilities dopo i test: {len(vulnerabilities)}")

                # Stop the server
                self._stop_mcp_server(server_process)
                logger.info("🛑 MCP server stopped")
            else:
                self._server_started = False
                logger.debug("Server could not be started for dynamic testing")

        except Exception as e:
            self._server_started = False
            logger.debug(f"Dynamic analysis encountered issues: {e}")

        logger.info(f"🔍 Dynamic analysis complete: {len(vulnerabilities)} issues found")
        return vulnerabilities

    async def _start_mcp_server_async(self, server_path: str, runtime_command: List[str]) -> Optional[subprocess.Popen]:
        """Start MCP server process - same async approach as UniversalStaticAnalyzer._start_mcp_server_process"""
        try:
            cmd = f"{runtime_command[0]} {runtime_command[1]}"
            logger.info(f"Starting MCP server (robustness): {cmd}")
            sys.stderr.flush()

            process = subprocess.Popen(
                cmd,
                shell=True,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                cwd=server_path,
                start_new_session=(os.name != "nt"),  # Linux: setsid() per killpg sull'intero tree
            )

            logger.info(f"Server Popen created (PID: {process.pid}), waiting 5s...")
            sys.stderr.flush()

            # Give server time to initialize (5s to handle uvx/npx download on first run)
            await asyncio.sleep(5)
            logger.info("5s wait completed, testing responsiveness...")
            sys.stderr.flush()

            # Test if server is responsive (same as real_fuzzing)
            if await self._test_server_responsiveness(process):
                self.running_servers.append(process)
                logger.info(f"✅ Started MCP server successfully (PID: {process.pid})")
                return process
            else:
                if process.poll() is None:
                    process.terminate()

        except Exception as e:
            logger.debug(f"Server startup attempt failed: {e}")

        logger.info("⚠️ Could not start MCP server")
        return None
    
    def _stop_mcp_server(self, process: subprocess.Popen):
        """Stop the MCP server process"""
        try:
            # Always close pipes first (even for dead processes) to avoid
            # "OSError: [Errno 22] Invalid argument" from garbage collector
            for handle in [process.stdin, process.stdout, process.stderr]:
                if handle and not handle.closed:
                    try:
                        handle.close()
                    except (OSError, ValueError):
                        pass

            if process and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()

            if process in self.running_servers:
                self.running_servers.remove(process)

        except Exception as e:
            logger.debug(f"Minor issue during server cleanup: {e}")
    
    def _pretty_jsonrpc_response(self, response: dict) -> str:
        if not response:
            return "null"

        response_copy = dict(response)

        error = response_copy.get("error")
        if isinstance(error, dict):
            msg = error.get("message")

            if isinstance(msg, str):
                try:
                    # Prova a parsare il JSON dentro la stringa
                    parsed = json.loads(msg)
                    error["message"] = parsed
                except json.JSONDecodeError:
                    pass  # resta stringa normale

        return json.dumps(response_copy, indent=2, ensure_ascii=False)


