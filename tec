    def _safe_extend(self, target: List[Vulnerability], items: Optional[List[Vulnerability]], source: str) -> None:
        """Safely extend vulnerability lists without crashing on None/non-iterables."""
        if items is None:
            logger.debug(f"{source} returned None; treating as empty list")
            return
        try:
            target.extend(items)
        except TypeError:
            logger.debug(f"{source} returned non-iterable {type(items).__name__}; treating as empty list")
            return
    
