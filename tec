    def _analyze_real_response(self, payload: Dict, response: Dict, server_info: MCPServerInfo) -> Dict:
        """Analyze REAL server response for vulnerabilities"""
        vulnerability = {
            "server": server_info.name,
            "payload": payload,
            "response": response,
            "vulnerabilities": [],
            "severity": "info",
            "timestamp": datetime.now().isoformat()
        }
        
        if not response:
            # No response is not a vulnerability — server may be slow or busy
            return None
            
        # Check for error responses that reveal information
        if "error" in response:
            error_msg = str(response["error"]).lower()
            payload_str = str(payload).lower()

            # Path traversal detection — only flag if the indicator is NOT
            # simply the echo of our own payload in the error message.
            path_indicators_err = ["/etc/", "/proc/", "c:\\"]
            new_path_info = [ind for ind in path_indicators_err
                             if ind in error_msg and ind not in payload_str]
            if new_path_info:
                vulnerability["vulnerabilities"].append("Path traversal information disclosure")
                vulnerability["severity"] = "high"

            # Command injection detection
            if any(cmd in error_msg for cmd in ["sh:", "bash:", "cmd:", "powershell"]):
                vulnerability["vulnerabilities"].append("Command injection attempt processed")
                vulnerability["severity"] = "high"

            # Stack trace disclosure
            if any(trace in error_msg for trace in ["traceback", "stack trace", "line ", "file \""]):
                vulnerability["vulnerabilities"].append("Stack trace information disclosure")
                vulnerability["severity"] = "medium"
                
        # === FIXED: Check the server RESPONSE for evidence of exploitation, not the payload ===
        if "result" in response:
            result = response["result"]
            result_str = str(result)
            result_str_lower = result_str.lower()

            # Detect if the MCP server flagged the response as an error.
            # When isError is true, indicator strings in the response are just
            # the payload being echoed back, not evidence of exploitation.
            server_reported_error = False
            if isinstance(result, dict):
                for content_item in result.get("content", []):
                    if isinstance(content_item, dict):
                        text_val = content_item.get("text", "")
                        if isinstance(text_val, str):
                            try:
                                inner = json.loads(text_val)
                                if isinstance(inner, dict) and inner.get("isError") is True:
                                    server_reported_error = True
                                    break
                            except (json.JSONDecodeError, TypeError):
                                pass
                            if '"isError":true' in text_val or '"isError": true' in text_val:
                                server_reported_error = True
                                break

            if not server_reported_error:
                # Build payload string to detect echo
                payload_str = str(payload).lower()

                # Check if response reveals path traversal success
                path_indicators = ["/etc/passwd", "/etc/shadow", "root:x:", "C:\\Windows", "\\system32"]
                new_path_hits = [ind for ind in path_indicators
                                 if ind in result_str and ind.lower() not in payload_str]
                if new_path_hits:
                    vulnerability["vulnerabilities"].append("Path traversal payload returned sensitive file content")
                    vulnerability["severity"] = "critical"

                # Check if response reveals command execution
                cmd_indicators = ["uid=", "gid=", "groups=", "drwx", "-rw-"]
                if any(ind in result_str for ind in cmd_indicators):
                    vulnerability["vulnerabilities"].append("Command injection payload returned shell output")
                    vulnerability["severity"] = "critical"

                # Check for sensitive info in response — only actual credential patterns
                method = payload.get("method", "")
                discovery_methods = ["tools/list", "resources/list", "prompts/list",
                                     "initialize", "ping"]
                if method not in discovery_methods:
                    sensitive_patterns = [
                        "password=", "password:", "passwd=", "passwd:",
                        "secret_key=", "secret_key:", "api_key=", "api_key:",
                        "access_token=", "access_token:", "private_key",
                        "-----BEGIN RSA", "-----BEGIN PRIVATE",
                        "AKIA",  # AWS access key prefix
                    ]
                    found_sensitive = [p for p in sensitive_patterns if p in result_str_lower]
                    if found_sensitive:
                        vulnerability["vulnerabilities"].append(f"Sensitive information disclosed: {', '.join(found_sensitive)}")
                        vulnerability["severity"] = "high"

        return vulnerability

