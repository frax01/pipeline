                # too generic and trigger on memory servers that echo stored keys.
                # Use patterns that only appear when a file is actually READ.
                path_traversal_indicators = [
                    "root:x:",          # /etc/passwd first line (Unix)
                    "daemon:x:",        # /etc/passwd daemon entry
                    "bin:x:",           # /etc/passwd bin entry
                    "root:$",           # /etc/shadow hash prefix
                    "nobody:x:",        # /etc/passwd nobody entry
                    "[autorun]",        # Windows autorun.inf content
                    "[boot loader]",    # Windows boot.ini content
                    "C:\\Windows\\System32\\",   # actual Windows dir content
                    "/proc/version",    # Linux kernel version file content
                    "/proc/self/exe",   # process self reference content
                ]
                new_path_hits = [ind for ind in path_traversal_indicators
                                 if ind in result_str and ind.lower() not in payload_str]
                if new_path_hits:
                    vulnerability["vulnerabilities"].append("Path traversal payload returned sensitive file content or path info")
                    vulnerability["severity"] = "critical"

