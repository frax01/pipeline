if __name__ == "__main__":
    # Write crash log to file so we can diagnose subprocess failures
    _crash_log = Path(__file__).parent / "mcp_guard_crash.log"
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "--test-dynamic":
            test_dynamic_fuzzing()
        else:
            main()
    except BrokenPipeError:
        # Pipe closed by caller — results already saved to JSON, safe to ignore
        pass
    except (OSError, IOError) as e:
        # Suppress Windows-specific subprocess cleanup errors
        if "Invalid argument" in str(e):
            pass  # Ignore this specific Windows error
        else:
            import traceback
            msg = f"I/O error occurred: {e}\n{traceback.format_exc()}"
            print(msg, file=sys.stderr)
            _crash_log.write_text(msg, encoding="utf-8")
    except KeyboardInterrupt:
        print("\nScan interrupted by user")
    except BaseException as e:
        import traceback
        msg = f"CRASH [{type(e).__name__}]: {e}\n{traceback.format_exc()}"
        print(msg, file=sys.stderr)
        try:
            _crash_log.write_text(msg, encoding="utf-8")
        except Exception:
            pass
        raise

