    def _perform_static_code_analysis(self, server_info: MCPServerInfo) -> List[Vulnerability]:
        """Walk source files and match dangerous patterns.

        Returns a list of Vulnerability objects with type='static',
        real file paths, line numbers and code snippets.
        """
        import re
        patterns = self._get_static_patterns()
        findings: List[Vulnerability] = []
        seen: set = set()  # deduplicate by (file, line, cwe)

        skip_dirs = {'.git', 'node_modules', '__pycache__', 'venv', '.venv',
                     'dist', 'build', '.next', 'vendor', 'test', 'tests',
                     '__tests__', 'spec', 'examples', 'docs',
                     'migrations', 'alembic', 'fixtures', 'seeds',
                     'scripts', 'benchmarks', 'coverage'}

        source_extensions = {'.py', '.js', '.ts', '.go', '.mjs', '.cjs'}

        try:
            for root, dirs, files in os.walk(server_info.local_path):
                dirs[:] = [d for d in dirs if d not in skip_dirs and not d.startswith('.')]

                for filename in files:
                    ext = os.path.splitext(filename)[1].lower()
                    if ext not in source_extensions:
                        continue

                    file_path = os.path.join(root, filename)
                    try:
                        with open(file_path, 'r', encoding='utf-8', errors='ignore') as fh:
                            content = fh.read()
                    except Exception:
                        continue

                    # Skip very large files (likely bundled/minified)
                    if len(content) > 500_000:
                        continue

                    rel_path = os.path.relpath(file_path, server_info.local_path)

                    for pattern_def in patterns:
                        # Language filter
                        lang_filter = pattern_def.get("languages")
                        if lang_filter and ext not in lang_filter:
                            continue

                        for match in pattern_def["regex"].finditer(content):
                            line_num = content[:match.start()].count('\n') + 1

                            # Deduplicate
                            dedup_key = (rel_path, line_num, pattern_def["cwe"])
                            if dedup_key in seen:
                                continue
                            seen.add(dedup_key)

                            # Extract snippet (the line containing the match)
                            line_start = content.rfind('\n', 0, match.start()) + 1
                            line_end = content.find('\n', match.start())
                            if line_end == -1:
                                line_end = len(content)
                            snippet = content[line_start:line_end].strip()[:150]

                            # Score
                            severity = pattern_def["severity"]
                            if severity == "critical":
                                cvss, aivss = 9.0, 7.0
                            elif severity == "high":
                                cvss, aivss = 7.5, 5.0
                            elif severity == "medium":
                                cvss, aivss = 5.0, 3.0
                            else:
                                cvss, aivss = 3.0, 2.0

                            from types import SimpleNamespace
                            score = SimpleNamespace(
                                cvss=SimpleNamespace(base_score=cvss, vector_string="", severity=severity.upper()),
                                aivss=SimpleNamespace(base_score=aivss, vector_string="", severity=f"AI_{severity.upper()}"),
                                overall_risk=severity.upper(),
                                business_impact="HIGH" if severity in ("critical", "high") else "MODERATE",
                                exploitability=severity.upper(),
                            )

                            vuln = Vulnerability(
                                id=f"static-{hash((rel_path, line_num, pattern_def['cwe'])) % 100000}",
                                type="static",
                                severity=severity,
                                title=pattern_def["title"],
                                description=(
                                    f"Static analysis found a dangerous code pattern in {rel_path} "
                                    f"at line {line_num}. Code: {snippet}"
                                ),
                                cwe_id=pattern_def["cwe"],
                                cve_id=None,
                                file_path=rel_path,
                                line_number=line_num,
                                remediation=pattern_def["remediation"],
                                cvss_score=score.cvss.base_score,
                                cvss_vector=score.cvss.vector_string,
                                cvss_severity=score.cvss.severity,
                                aivss_score=score.aivss.base_score,
                                aivss_vector=score.aivss.vector_string,
                                aivss_severity=score.aivss.severity,
                                overall_risk=score.overall_risk,
                                business_impact=score.business_impact,
                                exploitability=score.exploitability,
                                exploit_payload="",  # no fake payload
                                server_response="",  # no fake response
                                confidence="medium",
                            )
                            findings.append(vuln)

        except Exception as e:
            logger.error(f"Static analysis error: {e}")

        logger.info(f"🔍 Static analysis complete: {len(findings)} findings in {len(seen)} unique locations")
        return findings

    def _check_for_file_operations(self, server_info: MCPServerInfo) -> bool:
        """Check if server has file operation code"""
        return self._check_code_patterns(server_info, ['open(', 'file', 'read', 'write', 'os.path'])

    def _check_for_subprocess_calls(self, server_info: MCPServerInfo) -> bool:
        """Check if server has subprocess calls"""
        return self._check_code_patterns(server_info, ['subprocess', 'os.system', 'exec', 'shell'])

    def _check_for_eval_usage(self, server_info: MCPServerInfo) -> bool:
        """Check if server uses eval"""
        return self._check_code_patterns(server_info, ['eval(', 'exec(', 'compile('])

    def _check_for_child_process(self, server_info: MCPServerInfo) -> bool:
        """Check if Node.js server uses child_process"""
        return self._check_code_patterns(server_info, ['child_process', 'exec', 'spawn', 'fork'])

    def _check_for_fs_operations(self, server_info: MCPServerInfo) -> bool:
        """Check if Node.js server uses fs operations"""
        return self._check_code_patterns(server_info, ['fs.', 'readFile', 'writeFile', 'require(\'fs\')'])

    def _check_for_os_exec(self, server_info: MCPServerInfo) -> bool:
        """Check if Go server uses os/exec"""
        return self._check_code_patterns(server_info, ['os/exec', 'exec.Command', 'cmd.Run'])

    def _check_for_file_io(self, server_info: MCPServerInfo) -> bool:
        """Check if Go server uses file I/O"""
        return self._check_code_patterns(server_info, ['os.Open', 'ioutil.ReadFile', 'filepath.'])

    def _check_code_patterns(self, server_info: MCPServerInfo, patterns: List[str]) -> bool:
        """Check if any of the patterns exist in the server code"""
        result = self._find_code_patterns(server_info, patterns)
        return result is not None

    def _find_code_patterns(self, server_info: MCPServerInfo, patterns: List[str]):
        """Find patterns in server code. Returns (rel_file_path, line_number, snippet) or None."""
        try:
            for root, dirs, files in os.walk(server_info.local_path):
                dirs[:] = [d for d in dirs if not d.startswith('.') and d not in ['node_modules', '__pycache__', 'venv', 'dist']]

                for file in files:
                    if file.endswith(('.py', '.js', '.ts', '.go')):
                        file_path = os.path.join(root, file)
                        try:
                            with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
                                content = f.read()
                            content_lower = content.lower()
                            for pattern in patterns:
                                idx = content_lower.find(pattern.lower())
                                if idx != -1:
                                    line_num = content[:idx].count('\n') + 1
                                    line_start = content.rfind('\n', 0, idx) + 1
                                    line_end = content.find('\n', idx)
                                    if line_end == -1:
                                        line_end = len(content)
                                    snippet = content[line_start:line_end].strip()[:120]
                                    rel_path = os.path.relpath(file_path, server_info.local_path)
                                    return rel_path, line_num, snippet
                        except:
                            continue
        except:
            pass
        return None

    async def _run_http_dynamic_fuzzing(self, server_info: MCPServerInfo) -> List[Dict]:
        """Run dynamic fuzzing against HTTP-based MCP server"""
        logger.info("🌐 Running HTTP-based dynamic fuzzing...")

        # Start HTTP server using runtime_command (user-provided command like 'uvx pixelle@latest')
        process = await self._start_http_server_process(server_info)
        if not process:
            return []

        self._server_started = True

        # Detect the server port
        port = self._detect_http_server_port(server_info)
        base_url = f"http://localhost:{port}"
        logger.info(f"🌐 Using HTTP base URL: {base_url}")

        # Wait for HTTP server to be ready
        server_ready = await self._wait_for_http_server(base_url, timeout=15)
        if not server_ready:
            logger.warning(f"⚠️ HTTP server not responding on port {port}, trying common MCP endpoints...")
            # Try common MCP SSE/HTTP endpoints
            for alt_port in [8000, 8001, 3000, 9004, 5000]:
                if alt_port != port:
                    alt_url = f"http://localhost:{alt_port}"
                    if await self._wait_for_http_server(alt_url, timeout=3):
                        base_url = alt_url
                        port = alt_port
                        server_ready = True
                        logger.info(f"✅ Found server on port {alt_port}")
                        break

        vulnerabilities = []

        if not server_ready:
            logger.warning("⚠️ HTTP server not reachable, skipping HTTP fuzzing")
        else:
            try:
                # Generate HTTP fuzzing payloads
                payloads = self._generate_http_fuzzing_payloads()
                logger.info(f"🎯 Testing {len(payloads)} HTTP payloads against live server...")

                # Try common MCP HTTP endpoints
                mcp_endpoints = ["/mcp", "/sse", "/message", "/messages", "/"]
                working_endpoint = None

                for endpoint in mcp_endpoints:
                    test_url = f"{base_url}{endpoint}"
                    test_response = await self._send_http_request(payloads[0], test_url)
                    if test_response and "error" not in test_response:
                        working_endpoint = endpoint
                        logger.info(f"✅ Found working MCP endpoint: {endpoint}")
                        break
                    elif test_response and test_response.get("error", "").startswith("HTTP 4"):
                        # 4xx means the endpoint exists but rejected our payload
                        working_endpoint = endpoint
                        logger.info(f"✅ Found MCP endpoint (returned 4xx): {endpoint}")
                        break

                if not working_endpoint:
                    working_endpoint = "/mcp"
                    logger.info(f"⚠️ No confirmed endpoint, defaulting to {working_endpoint}")

                target_url = f"{base_url}{working_endpoint}"

                for i, payload in enumerate(payloads):
                    logger.info(f"Testing HTTP payload {i+1}/{len(payloads)}: {payload.get('method', 'unknown')}")

                    start_time = time.time()
                    response = await self._send_http_request(payload, target_url)
                    end_time = time.time()

                    # Analyze HTTP response for vulnerabilities
                    vuln = await self._analyze_http_response(payload, response, server_info)
                    if vuln:
                        vuln["response_time"] = end_time - start_time
                        vulnerabilities.append(vuln)

                    # Small delay between requests
                    await asyncio.sleep(0.5)

            except Exception as e:
                logger.error(f"Error during HTTP fuzzing: {e}")

        # Clean up the server process
        if process and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()

        return vulnerabilities

    def _detect_http_server_port(self, server_info: MCPServerInfo) -> int:
        """Detect the HTTP port from server source code"""
        common_port_patterns = [
            r'port\s*[=:]\s*(\d{4,5})',
            r'PORT\s*[=:]\s*(\d{4,5})',
            r'uvicorn\.run\s*\([^)]*port\s*=\s*(\d{4,5})',
            r'app\.run\s*\([^)]*port\s*=\s*(\d{4,5})',
            r'listen\s*\(\s*(\d{4,5})',
        ]

        # Search Python files for port configuration
        for root, dirs, files in os.walk(server_info.local_path):
            dirs[:] = [d for d in dirs if not d.startswith('.') and d not in ['node_modules', '__pycache__', 'venv', '.venv']]
            for file in files:
                if file.endswith(('.py', '.js', '.ts', '.toml', '.yaml', '.yml', '.env')):
                    try:
                        with open(os.path.join(root, file), 'r', encoding='utf-8', errors='ignore') as f:
                            content = f.read()
                            for pattern in common_port_patterns:
                                match = re.search(pattern, content)
                                if match:
                                    port = int(match.group(1))
                                    if 1024 <= port <= 65535:
                                        logger.info(f"🔍 Detected server port {port} from {file}")
                                        return port
                    except:
                        continue

        # Default port
        logger.info("🔍 No port detected, using default 8000")
        return 8000

    async def _wait_for_http_server(self, base_url: str, timeout: int = 15) -> bool:
        """Wait for HTTP server to become available"""
        import urllib.request
        import urllib.error

        start = time.time()
        while time.time() - start < timeout:
            try:
                req = urllib.request.Request(base_url, method='GET')
                urllib.request.urlopen(req, timeout=2)
                return True
            except urllib.error.URLError:
                await asyncio.sleep(1)
            except Exception:
                await asyncio.sleep(1)
        return False

    async def _start_http_server_process(self, server_info: MCPServerInfo) -> Optional[subprocess.Popen]:
        """Start HTTP server process using the runtime_command"""
        try:
            cmd = server_info.runtime_command
            if not cmd or not cmd[0]:
                logger.error("❌ No runtime command available for HTTP server")
                return None

            cmd_str = ' '.join(cmd)
            logger.info(f"Starting HTTP server: {cmd_str}")

            process = subprocess.Popen(
                cmd_str,
                shell=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                cwd=server_info.local_path,
                bufsize=0,
                start_new_session=(os.name != "nt"),  # Linux: setsid() per killpg sull'intero tree
            )

            # Give it time to start
            await asyncio.sleep(5)

            if process.poll() is None:
                logger.info(f"✅ HTTP server started (PID: {process.pid})")
                return process
            else:
                stdout, stderr = process.communicate()
                logger.error(f"❌ HTTP server failed to start:")
                if stdout:
                    logger.error(f"STDOUT: {stdout[:500]}")
                if stderr:
                    logger.error(f"STDERR: {stderr[:500]}")
                return None

        except Exception as e:
            logger.error(f"❌ Failed to start HTTP server: {str(e)}")
            return None

