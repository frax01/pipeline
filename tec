    def _has_unsafe_jsonrpc_handling(self, content: str):
        """Check for unsafe JSON-RPC message handling.
        Returns (is_vulnerable: bool, line_number: int, code_snippet: str)
        """
        # Look for JSON-RPC handling without validation
        unsafe_patterns = [
            r'(?i)json\.parse.*request.*without.*validation',
            r'(?i)message\[.*method.*\].*without.*check',
            r'(?i)params.*direct.*access.*without.*validation'
        ]

        validation_patterns = [
            r'(?i)(validate|check|verify).*json',
            r'(?i)(validate|check|verify).*method',
            r'(?i)(validate|check|verify).*params'
        ]

        has_validation = any(re.search(pattern, content, re.IGNORECASE) for pattern in validation_patterns)
        has_proper_validation = len([p for p in validation_patterns if re.search(p, content, re.IGNORECASE)]) >= 2

        # Check for explicit unsafe patterns first
        for pattern in unsafe_patterns:
            match = re.search(pattern, content, re.IGNORECASE)
            if match and not has_validation:
                line_num = content[:match.start()].count('\n') + 1
                return True, line_num, match.group(0)[:80]

        # Check for basic JSON-RPC handling without proper validation
        if not has_proper_validation:
            # Find the first occurrence of jsonrpc handling
            jsonrpc_patterns = [
                r'(?i)JSON\.parse\s*\(',
                r'(?i)["\']jsonrpc["\']',
                r'(?i)\.method\b',
                r'(?i)\bmethod\s*[=:]\s*',
            ]
            for pattern in jsonrpc_patterns:
                match = re.search(pattern, content)
                if match:
                    line_num = content[:match.start()].count('\n') + 1
                    # Get the full line for context
                    line_start = content.rfind('\n', 0, match.start()) + 1
                    line_end = content.find('\n', match.end())
                    if line_end == -1:
                        line_end = len(content)
                    snippet = content[line_start:line_end].strip()[:100]
                    return True, line_num, snippet

        return False, 0, ""
    
    def _has_missing_capability_validation(self, content: str):
        """Check for missing MCP capability validation.
        Returns (is_vulnerable: bool, line_number: int, code_snippet: str)
        """
        has_validation = any(re.search(pattern, content, re.IGNORECASE) for pattern in [
            r'validate.*capabilities',
            r'check.*capabilities',
            r'verify.*capabilities',
            r'capabilities.*required'
        ])

        if has_validation:
            return False, 0, ""

        # Find the initialize handler location
        init_patterns = [
            r'(?i)["\']initialize["\']',
            r'(?i)\.onInitialize\b',
            r'(?i)handle_initialize|handleInitialize',
            r'(?i)method\s*===?\s*["\']initialize["\']',
        ]
        for pattern in init_patterns:
            match = re.search(pattern, content)
            if match:
                line_num = content[:match.start()].count('\n') + 1
                line_start = content.rfind('\n', 0, match.start()) + 1
                line_end = content.find('\n', match.end())
                if line_end == -1:
                    line_end = len(content)
                snippet = content[line_start:line_end].strip()[:100]
                return True, line_num, snippet

        # Fallback: find 'capabilities' keyword
        cap_match = re.search(r'(?i)capabilities', content)
        if cap_match and 'initialize' in content.lower():
            line_num = content[:cap_match.start()].count('\n') + 1
            return True, line_num, ""

        return False, 0, ""
    
