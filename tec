        finally:
            # Clean up the server process - kill the entire process tree
            # On Windows, terminate() only kills the parent; child processes
            # (e.g. node workers) stay alive and keep pipes open, which blocks
            # the executor threads stuck on readline() and freezes asyncio.run().
            if process:
                logger.info("🛑 Stopping server process...")
                pid = process.pid
                # Kill process tree first (before closing pipes) so that
                # child processes release their pipe handles
                if process.poll() is None:
                    if os.name == "nt":
                        try:
                            subprocess.run(
                                ["taskkill", "/F", "/T", "/PID", str(pid)],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                timeout=5
                            )
                        except Exception:
                            process.kill()
                    else:
                        # Linux: uccide l'intero process group (shell + node/python + nipoti).
                        # Senza questo, gli orfani restano attaccati alle pipe e i thread
                        # readline() non finiscono mai -> asyncio.run() in deadlock.
                        import signal
                        try:
                            os.killpg(os.getpgid(pid), signal.SIGKILL)
                        except (ProcessLookupError, PermissionError, OSError):
                            try:
                                process.kill()
                            except Exception:
                                pass
                    try:
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        pass
                # Now close pipes to unblock any lingering executor threads
                for pipe in [process.stdin, process.stdout, process.stderr]:
                    if pipe and not pipe.closed:
                        try:
                            pipe.close()
                        except (OSError, ValueError):
                            pass

        return vulnerabilities

    async def _perform_live_fuzzing(self, process: subprocess.Popen, server_info: MCPServerInfo) -> List[Dict]:
        """Perform live fuzzing against running server.
        1. Handshake (initialize)
        2. Discover real tools via tools/list
        3. Generate injection payloads targeting each real tool's string parameters
        4. Send protocol-level payloads
        5. Analyze all responses"""
        vulnerabilities = []
        next_id = 1

        # ── Step 1: Initialize ──
        init_payload = {
            "jsonrpc": "2.0", "id": next_id, "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {"listChanged": True}, "resources": {"subscribe": True, "listChanged": True}},
                "clientInfo": {"name": "mcp-guard-fuzzer", "version": "1.0"}
            }
        }
        next_id += 1
        logger.info("📡 Sending initialize...")
        init_response = await self._send_real_mcp_message(process, init_payload)
        logger.info(f"Initialize response: {'OK' if init_response and 'result' in init_response else 'FAIL'}")

        # ── Step 2: Discover tools ──
        tools_payload = {"jsonrpc": "2.0", "id": next_id, "method": "tools/list", "params": {}}
        next_id += 1
        logger.info("📡 Sending tools/list...")
        tools_response = await self._send_real_mcp_message(process, tools_payload)

        discovered_tools = []
        if tools_response and "result" in tools_response:
            result = tools_response["result"]
            # tools/list returns {"tools": [...]} or directly [...]
            if isinstance(result, dict) and "tools" in result:
                discovered_tools = result["tools"]
            elif isinstance(result, list):
                discovered_tools = result
        logger.info(f"🔍 Discovered {len(discovered_tools)} tools")

        # ── Step 3: Generate targeted fuzzing payloads from real tools ──
        fuzzing_payloads = self._generate_targeted_fuzzing_payloads(discovered_tools, next_id)
        next_id += len(fuzzing_payloads)
        logger.info(f"🎯 Generated {len(fuzzing_payloads)} targeted fuzzing payloads")

        # Also test resources/read with path traversal
        resource_payloads = [
            {"jsonrpc": "2.0", "id": next_id, "method": "resources/list", "params": {}, "_category": "fuzzing"},
            {"jsonrpc": "2.0", "id": next_id + 1, "method": "resources/read", "params": {"uri": "file://../../etc/passwd"}, "_category": "fuzzing"},
            {"jsonrpc": "2.0", "id": next_id + 2, "method": "resources/read", "params": {"uri": "file:///etc/shadow"}, "_category": "fuzzing"},
            {"jsonrpc": "2.0", "id": next_id + 3, "method": "prompts/list", "params": {}, "_category": "fuzzing"},
        ]
        next_id += len(resource_payloads)

        # ── Step 4: Protocol-level payloads ──
        protocol_payloads = self._generate_protocol_payloads()
        for p in protocol_payloads:
            p["_category"] = "protocol"

        # ── Merge all and send ──
        all_payloads = fuzzing_payloads + resource_payloads + protocol_payloads
        total = len(all_payloads)
        n_fuzz = len(fuzzing_payloads) + len(resource_payloads)
        n_proto = len(protocol_payloads)
        logger.info(f"🚀 Sending {total} payloads ({n_fuzz} fuzzing + {n_proto} protocol)...")

        consecutive_timeouts = 0
        MAX_CONSECUTIVE_TIMEOUTS = 10
        PER_PAYLOAD_TIMEOUT = 13.0

        for i, payload in enumerate(all_payloads):
            category = payload.pop("_category", "fuzzing")
            method_name = payload.get("method", "unknown")
            tool_name = payload.get("params", {}).get("name", "") if isinstance(payload.get("params"), dict) else ""
            logger.info(f"[{i+1}/{total}] [{category}] {method_name} {tool_name}")

            # Bail out if server process died
            if process.poll() is not None:
                logger.warning(f"Server process died at payload {i+1}/{total}, stopping fuzzing")
                break

            start_time = time.time()
            try:
                response = await asyncio.wait_for(
                    self._send_real_mcp_message(process, payload),
                    timeout=PER_PAYLOAD_TIMEOUT
                )
                consecutive_timeouts = 0
            except asyncio.TimeoutError:
                consecutive_timeouts += 1
                logger.warning(f"[{i+1}/{total}] payload timeout after {PER_PAYLOAD_TIMEOUT}s — skipping")
                if consecutive_timeouts >= MAX_CONSECUTIVE_TIMEOUTS:
                    logger.warning(f"Too many consecutive timeouts ({consecutive_timeouts}), server likely stuck — aborting fuzzing")
                    break
                continue
            except Exception as e:
                logger.warning(f"[{i+1}/{total}] send error: {e} — skipping")
                continue
            end_time = time.time()

            vuln = await self._analyze_real_response(payload, response, server_info)
            if vuln is None:
                self._filtered_count = getattr(self, '_filtered_count', 0) + 1
                continue
            vuln["response_time"] = end_time - start_time
            vuln["type"] = category

            vulnerabilities.append(vuln)
            await asyncio.sleep(0.1)

        return vulnerabilities

    def _generate_targeted_fuzzing_payloads(self, tools: List[Dict], start_id: int) -> List[Dict]:
        """For each real tool, send each injection payload once.
        The injection value goes into the first string parameter; other required
        params get safe defaults."""
        payloads = []
        current_id = start_id

        # All injection payloads — one per attack vector, no duplicates
        injection_payloads = [
            # Path traversal
            "../../../etc/passwd",
            "....//....//etc/shadow",
            "/etc/passwd",
            "C:\\Windows\\System32\\config\\SAM",
            # Command injection
            "whoami; cat /etc/passwd",
            "$(id)",
            "`cat /etc/passwd`",
            "test && ls -la /",
            "test || id",
            # Code injection
            "__import__('os').system('id')",
            "require('child_process').execSync('id').toString()",
            "eval('1+1')",
            # SQL injection
            "' OR 1=1; --",
            "'; DROP TABLE users; --",
            "1 UNION SELECT * FROM information_schema.tables; --",
            # SSRF
            "http://169.254.169.254/latest/meta-data/",
            "http://localhost:6379/",
            "file:///etc/passwd",
        ]

        if not tools:
            logger.info("No tools discovered, using generic tool name fallback")
            generic_names = ["run", "execute", "read_file", "query", "fetch", "eval"]
            for tool_name in generic_names:
                for vector in injection_payloads:
                    payloads.append({
                        "jsonrpc": "2.0", "id": current_id,
                        "method": "tools/call",
                        "params": {"name": tool_name, "arguments": {"input": vector}},
                        "_category": "fuzzing"
                    })
                    current_id += 1
            return payloads

        for tool in tools:
            tool_name = tool.get("name", "")
            if not tool_name:
                continue

            # Find the first string parameter to inject into
            schema = tool.get("inputSchema", {})
            properties = schema.get("properties", {})
            required = schema.get("required", [])

            target_param = None
            for param_name, param_def in properties.items():
                if isinstance(param_def, dict) and param_def.get("type") == "string":
                    target_param = param_name
                    break
            if not target_param:
                target_param = "input"

            # For each injection vector, build one payload
            for vector in injection_payloads:
                arguments = {}
                # Fill required params with safe defaults
                for req_param in required:
                    if req_param == target_param:
                        continue
                    req_type = properties.get(req_param, {}).get("type", "string")
                    if req_type == "number":
                        arguments[req_param] = 1
                    elif req_type == "boolean":
                        arguments[req_param] = True
                    elif req_type == "array":
                        arguments[req_param] = []
                    else:
                        arguments[req_param] = "test"

                arguments[target_param] = vector

                payloads.append({
                    "jsonrpc": "2.0", "id": current_id,
                    "method": "tools/call",
                    "params": {"name": tool_name, "arguments": arguments},
                    "_category": "fuzzing"
                })
                current_id += 1

        logger.info(f"Generated {len(payloads)} targeted payloads for {len(tools)} tools")
        return payloads

    def _generate_protocol_payloads(self) -> List[Dict]:
        """Generate protocol-level fuzzing payloads.
        Tests JSON-RPC envelope validation and malformed input handling."""
        payloads = []

        # 1. Invalid JSON-RPC version
        payloads.append({"jsonrpc": "1.0", "id": 9000, "method": "tools/list"})
        payloads.append({"jsonrpc": "3.0", "id": 9001, "method": "tools/list"})
        payloads.append({"jsonrpc": "", "id": 9002, "method": "tools/list"})

        # 2. Missing required fields
        payloads.append({"id": 9010, "method": "tools/list"})           # missing jsonrpc
        payloads.append({"jsonrpc": "2.0", "method": "tools/list"})     # missing id
        payloads.append({"jsonrpc": "2.0", "id": 9011})                 # missing method

        # 3. Wrong field types
        payloads.append({"jsonrpc": "2.0", "id": "string_id", "method": "tools/list"})
        payloads.append({"jsonrpc": "2.0", "id": 9020, "method": 12345})
        payloads.append({"jsonrpc": "2.0", "id": 9021, "method": "tools/call", "params": "not_an_object"})
        payloads.append({"jsonrpc": "2.0", "id": 9022, "method": "tools/call", "params": [1, 2, 3]})
        payloads.append({"jsonrpc": "2.0", "id": 9023, "method": "tools/call", "params": {"name": None}})

        # 4. Edge-case IDs
        payloads.append({"jsonrpc": "2.0", "id": -1, "method": "tools/list"})
        payloads.append({"jsonrpc": "2.0", "id": 0, "method": "tools/list"})
        payloads.append({"jsonrpc": "2.0", "id": 99999999999, "method": "tools/list"})

        # 5. Empty / whitespace / special chars in method
        payloads.append({"jsonrpc": "2.0", "id": 9030, "method": ""})
        payloads.append({"jsonrpc": "2.0", "id": 9031, "method": "   "})
        payloads.append({"jsonrpc": "2.0", "id": 9032, "method": "tools/\x00list"})
        payloads.append({"jsonrpc": "2.0", "id": 9033, "method": "tools/../../../etc/passwd"})

        # 6. Oversized payload (resource exhaustion)
        payloads.append({
            "jsonrpc": "2.0", "id": 9040, "method": "tools/call",
            "params": {"name": "test", "arguments": {"data": "A" * 100000}}
        })

        # 7. Deeply nested object (stack overflow)
        nested = {"a": "b"}
        for _ in range(100):
            nested = {"nested": nested}
        payloads.append({"jsonrpc": "2.0", "id": 9041, "method": "tools/call", "params": nested})

        return payloads

    # ── STATIC CODE ANALYSIS ─────────────────────────────────────────────
    # Searches source code for dangerous patterns that indicate real
    # security weaknesses.  Findings are labelled type="static" and carry
    # the real file path, line number and a code snippet — no fake
    # payloads or responses are fabricated.

    # Pattern catalogue.  Each entry:
    #   regex          – compiled regex to match (case-insensitive)
    #   title          – human-readable vulnerability title
    #   cwe            – CWE-ID
    #   severity       – critical / high / medium / low
    #   remediation    – short fix suggestion
    #   languages      – file extensions this pattern applies to (None = all)
    #   context_filter – optional callable(match_line) → bool to reduce FP

    _STATIC_PATTERNS = None  # lazy-initialised

    @classmethod
    def _get_static_patterns(cls):
        """Lazy-init the pattern list so `re.compile` runs only once."""
        if cls._STATIC_PATTERNS is not None:
            return cls._STATIC_PATTERNS

        import re

        cls._STATIC_PATTERNS = [
            # ── Command Injection ──
            {
                "regex": re.compile(
                    r"""(?:os\.system|os\.popen|subprocess\.(?:call|run|Popen|check_output|check_call))\s*\("""
                    r"""[^)]*(?:\bf\s*["']|\.format\s*\(|%\s*\(|\+\s*\w)""",
                    re.IGNORECASE
                ),
                "title": "Command Injection — unsanitised input in subprocess/os call",
                "cwe": "CWE-78",
                "severity": "critical",
                "remediation": "Use subprocess with a list of arguments instead of shell strings. Never interpolate user input into commands.",
                "languages": {".py"},
            },
            {
                "regex": re.compile(
                    r"""child_process\.(?:exec|execSync)\s*\("""
                    r"""[^)]*(?:`|\$\{|\+\s*\w)""",
                    re.IGNORECASE
                ),
                "title": "Command Injection — unsanitised input in child_process.exec",
                "cwe": "CWE-78",
                "severity": "critical",
                "remediation": "Use child_process.execFile or spawn with an argument array. Never build shell commands from user input.",
                "languages": {".js", ".ts", ".mjs", ".cjs"},
            },
            {
                "regex": re.compile(
                    r"""exec\.Command\s*\([^)]*\+""",
                    re.IGNORECASE
                ),
                "title": "Command Injection — string concatenation in exec.Command",
                "cwe": "CWE-78",
                "severity": "critical",
                "remediation": "Pass arguments as separate elements to exec.Command. Never concatenate user input into the command string.",
                "languages": {".go"},
            },
            # ── Code Injection (eval) ──
            {
                "regex": re.compile(
                    r"""\beval\s*\([^)]*(?:\bf\s*["']|\.format\s*\(|%\s*\(|\+\s*\w)""",
                    re.IGNORECASE
                ),
                "title": "Code Injection — eval with dynamic input",
                "cwe": "CWE-94",
